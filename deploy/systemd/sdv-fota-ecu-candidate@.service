[Unit]
Description=SDV shadow trial candidate worker (%i)
Requires=sdv-fota-launcher.service
After=sdv-fota-launcher.service
PartOf=sdv-fota-launcher.service
RequiresMountsFor=/var/lib/sdv-fota

[Service]
Type=simple
User=root
Group=root
SupplementaryGroups=
EnvironmentFile=/etc/default/sdv-fota-launcher
ExecStart=/usr/bin/sdv-fota-launcher --state-root /var/lib/sdv-fota --target %i --trial-candidate --app-arg --ecu --app-arg %i --app-arg --worker-socket --app-arg /run/sdv-picarx/candidates/%i.sock --app-arg --coordinator-socket --app-arg /run/sdv-picarx/candidates/coordinator.sock
Restart=no
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sdv-fota /run/sdv-picarx

