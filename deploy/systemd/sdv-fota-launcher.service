[Unit]
Description=SDV A/B application slot launcher
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
SupplementaryGroups=
EnvironmentFile=/etc/default/sdv-fota-launcher
ExecStart=/usr/bin/sdv-fota-launcher /var/lib/sdv-fota /usr/bin/sdv-health-check
Restart=always
RestartSec=2
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sdv-fota

[Install]
WantedBy=multi-user.target
