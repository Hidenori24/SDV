[Unit]
Description=SDV A/B application slot launcher
After=local-fs.target
RequiresMountsFor=/var/lib/sdv-fota

[Service]
Type=simple
User=root
Group=root
SupplementaryGroups=
EnvironmentFile=/etc/default/sdv-fota-launcher
RuntimeDirectory=sdv-picarx sdv-fota
RuntimeDirectoryMode=0750
Environment=SDV_FOTA_HOLD_SOCKET=/run/sdv-fota/control.sock
ExecStartPre=/usr/bin/chown sdv-app:sdv-app /run/sdv-picarx
ExecStartPre=/usr/bin/install -d -o sdv-app -g sdv-app -m 0700 /run/sdv-picarx/workers
ExecStartPre=/usr/bin/install -d -o sdv-app -g sdv-app -m 0700 /run/sdv-picarx/candidates
ExecStart=/usr/bin/sdv-fota-launcher /var/lib/sdv-fota /usr/bin/sdv-picarx-health --socket /run/sdv-picarx/health.sock
Restart=always
RestartSec=2
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sdv-fota /run/sdv-picarx /run/sdv-fota

[Install]
WantedBy=multi-user.target
